{
  "name": "erp-sap-cls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch src/server/index.js\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/a0-visual.spec.js --project=desktop",
    "test:visual:update": "playwright test e2e/a0-visual.spec.js --project=desktop --update-snapshots",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.mjs down",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed_demo.mjs",
    "erp:discover": "python scripts/erp_discover.py",
    "erp:schema-diff": "node scripts/schema_diff.mjs",
    "erp:route-check": "node scripts/route_check.mjs",
    "erp:permission-audit": "node scripts/permission_audit.mjs",
    "erp:tokens": "node scripts/build_tokens.mjs && node scripts/build_icons.mjs",
    "erp:rotate-vault-key": "node scripts/rotate_vault_key.mjs",
    "erp:golden": "node scripts/golden.mjs",
    "erp:regression": "node scripts/regression.mjs",
    "test:coverage": "node scripts/test_coverage.mjs",
    "erp:migration-check": "node scripts/migration_check.mjs",
    "erp:secret-scan": "node scripts/secret_scan.mjs",
    "erp:coverage-gate": "node scripts/coverage_gate.mjs",
    "erp:audit": "npm audit --audit-level=high",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "release": "node scripts/release.mjs",
    "erp:db-check": "node scripts/db_check.mjs",
    "erp:db-lint": "node scripts/db_lint.mjs",
    "erp:db-baseline": "node scripts/db_baseline.mjs",
    "erp:gen-data": "node scripts/gen_data.mjs",
    "erp:perf-baseline": "node scripts/perf_baseline.mjs",
    "erp:search-perf": "node scripts/search_perf.mjs",
    "erp:workflow-perf": "node scripts/workflow_perf.mjs",
    "erp:pcs-perf": "node scripts/pcs_perf.mjs",
    "erp:acc-perf": "node scripts/acc_perf.mjs",
    "erp:ntf-perf": "node scripts/ntf_perf.mjs",
    "erp:comm-perf": "node scripts/comm_perf.mjs",
    "erp:tsk-perf": "node scripts/tsk_perf.mjs",
    "erp:alr-perf": "node scripts/alr_perf.mjs",
    "erp:doc-perf": "node scripts/doc_perf.mjs",
    "erp:tpl-perf": "node scripts/tpl_perf.mjs",
    "erp:sig-perf": "node scripts/sig_perf.mjs",
    "erp:xl-perf": "node scripts/xl_perf.mjs",
    "erp:col-perf": "node scripts/col_perf.mjs",
    "erp:bud-dept-perf": "node scripts/bud_dept_perf.mjs",
    "erp:plan-perf": "node scripts/plan_perf.mjs",
    "erp:plan-gantt-perf": "node scripts/plan_gantt_perf.mjs",
    "erp:plan-baseline-perf": "node scripts/plan_baseline_perf.mjs",
    "erp:plan-lookahead-perf": "node scripts/plan_lookahead_perf.mjs",
    "erp:plan-delay-perf": "node scripts/plan_delay_perf.mjs",
    "erp:site-wa-perf": "node scripts/site_wa_perf.mjs",
    "erp:site-dpr-perf": "node scripts/site_dpr_perf.mjs",
    "migration:new": "node scripts/new_migration.mjs",
    "backfill": "node --env-file-if-exists=.env scripts/backfill.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db_backup.mjs",
    "db:restore": "node scripts/db_restore.mjs",
    "db:rehearse": "node scripts/rehearse_backup.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.105.0",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "1.66.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "redis": "^6.3.1",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.11.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
