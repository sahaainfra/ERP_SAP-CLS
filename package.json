{
  "name": "erp-sap-cls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch src/server/index.js\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "test:e2e": "playwright test",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.mjs down",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed_demo.mjs",
    "erp:discover": "python scripts/erp_discover.py",
    "erp:schema-diff": "node scripts/schema_diff.mjs",
    "erp:golden": "node scripts/golden.mjs",
    "erp:regression": "node scripts/regression.mjs",
    "test:coverage": "node scripts/test_coverage.mjs",
    "erp:migration-check": "node scripts/migration_check.mjs",
    "erp:secret-scan": "node scripts/secret_scan.mjs",
    "erp:coverage-gate": "node scripts/coverage_gate.mjs",
    "erp:audit": "npm audit --audit-level=high",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
