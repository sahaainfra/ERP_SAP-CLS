# Copy to .env. Names and meanings are validated at start-up (src/server/config.js).
# NODE_ENV: development | test | staging | production
NODE_ENV=development
PORT=3000
# SQLite file path (use :memory: only in tests)
DATABASE_PATH=data/erp.dev.sqlite
# Environment-default scope for feature flags; normally equals NODE_ENV
ERP_ENVIRONMENT=development
# dev-headers = trusted X-Erp-* headers (development/test only). Production needs the IAM module (part 02.x).
AUTH_MODE=dev-headers
# Demo/sandbox seed guard. Must be false in staging and production.
ERP_DEMO_SEED=false

# Optional: directory the readiness check must be able to write to (default: the database folder)
# STORAGE_PATH=data
# Optional: lets a monitoring system call /health/ready without signing in (at least 16 characters)
# HEALTH_TOKEN=

# Signs the short-lived file download links (at least 32 characters). Required in staging and production; must be the same on every instance.
# FILE_URL_SECRET=
# Optional: a ClamAV daemon (clamd) that scans every upload in addition to the built-in test-signature scanner.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Encrypts the credentials of external connectors (email, SMS, GST, bank ...) at rest (at least 32 characters). Required in staging and
# production; must be the same on every instance. Losing it makes the stored credentials unreadable, so keep a copy in the secrets manager.
# VAULT_KEY=

# Signs sign-in tokens (at least 32 characters). Required in staging and production when AUTH_MODE=iam; must be the same on every instance.
# AUTH_SECRET=
