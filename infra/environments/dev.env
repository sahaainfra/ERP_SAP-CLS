# Part 30.08 FR-01: the non-secret configuration of the dev environment. Secrets (AUTH_SECRET, VAULT_KEY, FILE_URL_SECRET, HEALTH_TOKEN,
# BACKUP_KEY, PUSH_VAPID_PRIVATE_KEY) come from the vault into the host's environment; scripts/env_parity.mjs checks every environment
# names the same keys and differs only where docs/erp/runbooks/environments.md allows.
NODE_ENV=development
ERP_ENVIRONMENT=development
AUTH_MODE=dev-headers
DATABASE_PATH=/data/erp-dev.sqlite
STORAGE_PATH=/data/storage
ERP_DEMO_SEED=true
ERP_SANDBOX=false
PUBLIC_URL=https://erp-dev.example.in
APP_URL=https://erp-dev.example.in
BACKUP_OFFSITE_DIR=/backup/offsite/dev
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
PUSH_SUBJECT=mailto:it-support@example.in
