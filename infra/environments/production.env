# Part 30.08 FR-01: the non-secret configuration of the production environment. Secrets (AUTH_SECRET, VAULT_KEY, FILE_URL_SECRET, HEALTH_TOKEN,
# BACKUP_KEY, PUSH_VAPID_PRIVATE_KEY) come from the vault into the host's environment; scripts/env_parity.mjs checks every environment
# names the same keys and differs only where docs/erp/runbooks/environments.md allows.
NODE_ENV=production
ERP_ENVIRONMENT=production
AUTH_MODE=iam
DATABASE_PATH=/data/erp.sqlite
STORAGE_PATH=/data/storage
ERP_DEMO_SEED=false
ERP_SANDBOX=false
PUBLIC_URL=https://erp.example.in
APP_URL=https://erp.example.in
BACKUP_OFFSITE_DIR=/backup/offsite/production
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
PUSH_SUBJECT=mailto:it-support@example.in
